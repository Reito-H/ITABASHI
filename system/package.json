{
  "name": "benten-system",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute benten-db --local --file=src/db/schema.sql",
    "db:init:remote": "wrangler d1 execute benten-db --file=src/db/schema.sql",
    "db:seed": "wrangler d1 execute benten-db --local --file=src/db/seed.sql",
    "setup-admin": "wrangler d1 execute benten-db --local --file=src/db/setup_admin.sql",
    "test": "vitest run"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "hono": "^4.6.0",
    "pdf-lib": "^1.17.1",
    "qrcode-generator": "^1.5.2",
    "unpdf": "^1.6.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.21",
    "@cloudflare/workers-types": "^5.20260723.1",
    "typescript": "^5.5.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.113.0"
  }
}
